# backend 디렉터리에서 개발 실행 시 명시적으로 환경변수에 전달합니다.
APP_ENV=development
AUTH_MODE=development
PORT=8080
DATABASE_PATH=./data/market.db
UPLOAD_DIR=./data/uploads
WEB_DIR=../frontend/dist
APP_ORIGIN=http://localhost:5173
SESSION_TTL=8h
# 운영: APP_ENV=production, AUTH_MODE=google. 실제 값은 Railway 변수에만 저장합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
